          "须给出运营成本率取值与依据（不得默认引用内置示意区间而不标注）",
          "须说明样本量与离散度，并建议与用户成本法交叉验证"
        ],
        "mustNotClaim": [
          "给出貌似有权威来源的 cap rate 引用数字",
          "跨城市或跨物业类型套用同一个 cap rate",
          "把推导值写成引用值"
        ],
        "expectedRange": {
          "min": 0.02,
          "max": 0.06,
          "unit": "净资本化率"
        },
        "expectedCaliber": "推导值口径（标注级：测算或估算）"
