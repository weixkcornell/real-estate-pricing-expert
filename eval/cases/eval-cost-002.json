{
  "id": "eval-cost-002",
  "capability": "rep.cost.residual",
  "question": "这块待开发宅地，用假设开发法估它的价值。",
  "inputData": {
    "数据说明": "合成演示数据：待开发宅地（含规划条件）",
    "字段": "楼面价、规划建筑面积、开发成本、税费",
    "位置": "adapters/fixtures/land_demo.csv（合成生成）",
    "口径": "土地出让成交口径（楼面价）"
  },
  "expectedAnswer": {
    "mustMention": [
      "假设开发法：开发后价值-成本-税费",
      "须用楼面价/地价",
      "在建工程同样适用",
      "折现或利润率假设须声明",
      "出让条件（配建/自持）须建模"
    ],
    "mustNotClaim": [
      "用比较法直接估",
      "忽略开发成本",
      "忽略出让条件"
    ],
    "expectedRange": { "min": 8000, "max": 50000, "unit": "元/㎡楼面价（合成推导示例）" },
    "expectedCaliber": "楼面价"
  },
  "rubric": [
    {"dimension": "关键方法要点覆盖", "weight": 0.30, "manual": false, "check": "mustMention",
     "levels": ["1分：完全遗漏关键要点", "2分：覆盖不超过1/3要点", "3分：覆盖约半数要点", "4分：覆盖至少2/3要点", "5分：覆盖全部要点并展开说明"]},
    {"dimension": "禁区与反模式规避", "weight": 0.25, "manual": false, "check": "mustNotClaim",
     "levels": ["1分：出现被禁止的说法/混称（踩中反模式）", "2分：部分禁区未规避", "3分：基本规避但表述含糊", "4分：明确规避并说明原因", "5分：明确规避且主动提示风险与不确定性"]},
    {"dimension": "数据口径与来源声明", "weight": 0.20, "manual": false, "check": "expectedCaliber",
     "levels": ["1分：未声明任何口径或来源，数字不可追溯", "2分：提及口径但缺来源或截至期", "3分：口径与来源齐全、可复现", "4分：多源交叉验证且一致", "5分：多源+指标代码+口径声明齐全，数据底座单一真源"]},
    {"dimension": "数值落区合理性", "weight": 0.15, "manual": false, "check": "expectedRange",
     "levels": ["1分：未给数值或严重偏离区间", "2分：数值偏离区间", "3分：数值接近区间边缘", "4分：数值落入区间", "5分：数值落入区间且给出分布/稳健性"]},
    {"dimension": "区间与不确定性披露", "weight": 0.05, "manual": true,
     "levels": ["1分：仅点估计，无区间", "2分：有区间但未说明来源", "3分：区间来源明确且与数据层级匹配", "4分：区间来源明确+覆盖率或校准检验", "5分：区间来源明确+覆盖率检验+多源不确定性合成"]},
    {"dimension": "解释深度与证据链", "weight": 0.05, "manual": true,
     "levels": ["1分：结论无方法依据", "2分：有方法但未展开", "3分：方法+数据底座清晰", "4分：方法清晰+稳健性检验", "5分：方法清晰+稳健性+替代方法交叉验证"]}
  ],
  "dataProvenance": "合成演示数据（adapters/fixtures/land_demo.csv 由脚本合成生成）；非真实地价，仅用于演示假设开发法流程。"
